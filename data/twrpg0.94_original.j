set poll=Io_o()call lqiIi('I05Y',"海洋秩序","某船长")set poIl=poIl+("我一直认为拉芙海所存在的最大生物")+"
"set poIl=poIl+("是龙龟。直到那个生物的出现才改变了我的想法 ..")+"
"set poIl=poIl+("它不知道从哪里跳出来并把我们的船撕裂了")+"
"
set poIl=poIl+("船上所有水手全被它吃掉了。我绝望的认为我也玩完了。")+"
"set poIl=poIl+("但是，不知道什么原因，我昏迷了")+"
"
set poIl=poIl+("醒来时，发现我躺在了海岸上。我不知道到底发生什么了情况")+"
"
set poIl=poIl+("不过，我依稀记得一个背影和白色烟雾消失")+"
"
set poIl=poIl+("在我的视野中.")+"
"call SaveStr(Nv,(((poll))),(pool),(poIl))call lqiIi('I056',"古堡教堂的异常","一位魔法士")
set poIl=poIl+("这个故事发生在我曾经去瓦拉几亚帝国拯救同伴的时候.")+"
"
set poIl=poIl+("当我在瓦拉几亚帝国深处的古堡搜寻到同伴")+"
"
set poIl=poIl+("同时发现了一座不寻常的大教堂.")+"
"set poIl=poIl+("我们都非常好奇地想进入这个教堂一探究竟.")+"
"set poIl=poIl+("我们试用了好多方法终于把那个冻结的教堂门打开")+"
"set poIl=poIl+("那一刻，我感受到了强烈的寒意。呵呵，当然不是指我的身体被冻住了.")+"
"set poIl=poIl+("由于这强烈的寒冷气息，我们无论如何也不敢在进入半步")+"
"set poIl=poIl+("就这样，我们返回了法师塔.")+"
"
call SaveStr(Nv,(((poll))),(pool),(poIl))call lqiIi('I057',"混沌天空","著名的普瑞斯雕塑家")set poIl=poIl+("我喜欢普瑞斯，作为那里的最著名雕塑家")+"
"set poIl=poIl+("我的雕塑作品没有一个不是由固态熔岩制作的")+"
"set poIl=poIl+("这也是我雇佣战士经常去熔岩火山的原因")+"
"set poIl=poIl+("在那个非常普通的一天，见到一个人站在火山口")+"
"set poIl=poIl+("面貌已记不太清，但应该一名训练有素的强壮战士")+"
"set poIl=poIl+("他向火山口丢了一些绿色粉末")+"
"set poIl=poIl+("当我正感到奇怪之时，天空正变得暗淡混沌")+"
"
set poIl=poIl+("突然某个地方传来一声巨响 !!")+"
"set poIl=poIl+("我感到害怕仓惶逃走，而那个战士奔向传来巨响的地方.")+"
"
call SaveStr(Nv,(((poll))),(pool),(poIl))call lqiIi('I069',"万圣节盛会","普瑞斯的公民")set poIl=poIl+("普瑞斯还有一个重要的节日，就是万圣节.")+"
"set poIl=poIl+("这个节日也是普瑞斯的一个化妆盛会")+"
"set poIl=poIl+("在狂欢节中，我们都会聚集在喷水池前愉快地玩耍")+"
"set poIl=poIl+("有传言这里曾有一个鬼魂出来伤害这里的居民")+"
"set poIl=poIl+("事实到底如何我也不知道.")+"
"call SaveStr(Nv,(((poll))),(pool),(poIl))call lqiIi('I06A',"叛变的魔法士","一位魔法士")set poIl=poIl+("传言很久以前法师塔里有个非常优秀的魔法士")+"
"set poIl=poIl+("他参悟了非常强大的魔法技能")+"
"set poIl=poIl+("他的力量早已超乎一般魔法士。正因如此，人们称之为")+"
"set poIl=poIl+("魔法之王.")+"
"
set poIl=poIl+("然而，有一天他突然离开了法师塔.")+"
"set poIl=poIl+("人们都说他出卖了他的灵魂给魔鬼")+"
"
set poIl=poIl+("并可以肯定他的灵魂已经黑化")+"
"set poIl=poIl+("这个传言是否真实有待考证.")+"
"
call SaveStr(Nv,(((poll))),(pool),(poIl))call lqiIi('I05Z',"凌霜冰魄","一位魔法士")set poIl=poIl+("我已经在法师塔里生活了50多年.")+"
"set poIl=poIl+("这里我见到了太多的人和事发生，但其中让我印象最深刻的就是")+"
"set poIl=poIl+("关于冰霜领主的传说。在冰山雪地，")+"
"set poIl=poIl+("他被称为“全能之神”。传说曾经有个非常强大的魔法士")+"
"set poIl=poIl+("在冰山雪地见到过他")+"
"set poIl=poIl+("我从不相信那个传说，虽然它一直被人津津乐道")+"
"set poIl=poIl+("有一天，在我向普瑞斯都城运送粉末的途中")+"
"
set poIl=poIl+("不小心散落了一些粉末，我就去捡拾它们.")+"
"set poIl=poIl+("此时，我看到了一个庞然大物，那一瞬间我感到巨大恐惧而晕倒了，当我醒来时")+"
"
set poIl=poIl+("我就在法师塔了（略）-最强大的冰系魔法士罗哈迪斯-")+"
"call SaveStr(Nv,(((poll))),(pool),(poIl))call lqiIi('I066',"深寒洞穴","普瑞斯魔导士")set poIl=poIl+("如果你深入到冰霜陆地，你会发现一个洞穴")+"
"
set poIl=poIl+("据说一直以来在里面的蜘蛛为避免遭受人类的骚扰")+"
"set poIl=poIl+("而巢居此处。不过，最近蜘蛛们经常出穴")+"
"set poIl=poIl+("攻击附近的村庄，因此普瑞斯都城")+"
"
set poIl=poIl+("派遣一支军队对其进行讨伐，我也是其中一员")+"
"set poIl=poIl+("且也是唯一的幸存者。我们勇敢地战斗，但")+"
"
set poIl=poIl+("战士们一个接一个的被无情的拖入到它们的洞穴中，当时军队的")+"
"set poIl=poIl+("指挥官，拉瓦安斯，进去要给予蜘蛛一致命打击")+"
"set poIl=poIl+("并与之同归于尽，但蜘蛛女王并没有si.")+"
"set poIl=poIl+("我意识到这场战斗是徒劳的，最后我决定")+"
"set poIl=poIl+("从结界逃跑了。讨伐战斗不能持续很长时间，")+"
"set poIl=poIl+("因为洞穴里会持续收到严寒伤害。请勇敢的战士将它击败吧.")+"
"set poIl=poIl+("让我们的牺牲有点价值.")+"
"call SaveStr(Nv,(((poll))),(pool),(poIl))call lqiIi('I0CI',"xue色面具","乔纳安·杰斯特")
set poIl=poIl+("这里讲述的就是瓦几内拉帝国灭亡的真实原因.")+"
"
set poIl=poIl+("掌权者...由于一个面具")+"
"set poIl=poIl+("在战争中灭亡了。没人知道")+"
"set poIl=poIl+("那个面具是从哪里而来。但，任何穿戴上它的人的脸")+"
"
set poIl=poIl+("据说都会鲜xue淋漓并且变成一个幽灵模样")+"
"set poIl=poIl+("任何一个正在读我这本书的人.")+"
"set poIl=poIl+("都要小心那个幽灵")+"
"set poIl=poIl+("即使最强大的瓦几内拉帝国精英战士")+"
"set poIl=poIl+("都对这个对手无可奈何.")+"
"call SaveStr(Nv,(((poll))),(pool),(poIl))call lqiIi('I0CL',"祈祷书","海难幸存的船长")set poIl=poIl+("在拉夫海深处的深海，那里存在一个")+"
"set poIl=poIl+("神秘的不明生物.")+"
"set poIl=poIl+("许多试图穿越那个区域的船只都被破坏.")+"
"set poIl=poIl+("更可怕的是，那里据说被一个")+"
"set poIl=poIl+("让所有人都为之恐惧的沧海巨兽统治着")+"
"set poIl=poIl+("它喜欢出现在它视野中的闪亮球体.")+"
"set poIl=poIl+("许多探险家试图去查看下这个巨兽乌龟，但")+"
"
set poIl=poIl+("他们大多数都还未结晶它之时")+"
"set poIl=poIl+("已被触角刹si.")+"
"call SaveStr(Nv,(((poll))),(pool),(poIl))call lqiIi('I0CV',"封印之塔","无名氏")set poIl=poIl+("任何人有时在钻研某项法术时")+"
"set poIl=poIl+("很容易变得走火入魔并失去自我.")+"
"set poIl=poIl+("当法术变得具有强大破坏力并已不受控制之时")+"
"set poIl=poIl+("没有人能迅速打破它.")+"
"set poIl=poIl+("在远古秘境中有一座塔，里面有一个生物")+"
"set poIl=poIl+("由于具有腐败性法术而被封禁")+"
"set poIl=poIl+("它充满了愤恨")+"
"set poIl=poIl+("并且它时刻保持警戒以便打败...")+"
"set poIl=poIl+("任何试图挑战它的探险家（略）")+"
