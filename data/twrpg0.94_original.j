yer(9),Player(6),true)call SetPlayerAllianceStateVisionBJ(Player(9),Player(7),true)call SetPlayerAllianceStateVisionBJ(Player(9),Player(8),true)call SetPlayerAllianceStateVisionBJ(Player(9),Player($A),true)call SetPlayerAllianceStateVisionBJ(Player($A),Player(0),true)call SetPlayerAllianceStateVisionBJ(Player($A),Player(1),true)call SetPlayerAllianceStateVisionBJ(Player($A),Player(2),true)call SetPlayerAllianceStateVisionBJ(Player($A),Player(3),true)call SetPlayerAllianceStateVisionBJ(Player($A),Player(4),true)call SetPlayerAllianceStateVisionBJ(Player($A),Player(5),true)call SetPlayerAllianceStateVisionBJ(Player($A),Player(6),true)call SetPlayerAllianceStateVisionBJ(Player($A),Player(7),true)call SetPlayerAllianceStateVisionBJ(Player($A),Player(8),true)call SetPlayerAllianceStateVisionBJ(Player($A),Player(9),true)call SetPlayerTeam(Player($B),1)
endfunctionfunction YDWEIsEventAttackDamage takes nothing returns boolean    return 0!=EXGetEventDamageData(YDWEEventDamageData__EVENT_DAMAGE_DATA_IS_ATTACK)endfunctionfunction Trig_ZSFSX_PG_Conditions takes nothing returns boolean    local unit attacker=GetEventDamageSource()    local unit target=GetTriggerUnit()    local boolean result    if attacker==null or target==null then        set attacker=null        set target=null        return false    endif    set result=(IsUnitType(attacker,UNIT_TYPE_HERO)==true) and (WWNNWNWN) and (GetPlayerController(GetOwningPlayer(attacker))==MAP_CONTROL_USER) and (IsUnitIllusion(attacker)==false) and (IsUnitEnemy(target,GetOwningPlayer(attacker))==true) and (YDWEIsEventAttackDamage()==true) and (IsUnitAliveBJ(attacker)==true) and (IsUnitAliveBJ(target)==true)    set attacker=null    set target=null    return resultendfunctionfunction Trig_ZSFSX_PGActions takes nothing returns nothing    local unit attacker=GetEventDamageSource()    local unit target=GetTriggerUnit()    local real totalStats    local real addDamage    local integer randomValue    local texttag tag    local real x    local real y    if attacker==null or target==null then        set attacker=null        set target=null        return    endif    set totalStats=I2R(GetHeroStr(attacker,true)+GetHeroAgi(attacker,true)+GetHeroInt(attacker,true))    set randomValue=GetRandomInt(1,100)    if randomValue<=5 then        set addDamage=totalStats*I2R(GetUnitLevel(attacker))        set x=GetUnitX(target)        set y=GetUnitY(target)        set tag=CreateTextTag()        call SetTextTagText(tag,"★暴击 +"+I2S(R2I(addDamage))+"★",0.030)        call SetTextTagColor(tag,255,215,0,0)        call SetTextTagPos(tag,x,y,80.0)        call SetTextTagVelocity(tag,0,0.05)        call SetTextTagPermanent(tag,false)        call SetTextTagLifespan(tag,2.5)        call SetTextTagFadepoint(tag,1.8)        call SetTextTagVisibility(tag,true)        set tag=null    else        set addDamage=totalStats*10.0    endif    if addDamage>0 then        call UnitDamageTarget(attacker,target,addDamage,false,false,ATTACK_TYPE_MAGIC,DAMAGE_TYPE_ENHANCED,WEAPON_TYPE_WHOKNOWS)    endif    set attacker=null    set target=nullendfunctionfunction InitTrig_ZSFSX_PG takes nothing returns nothing    set gg_trg_ZSFSX_PG=CreateTrigger()    call YDWESyStemAnyUnitDamagedRegistTrigger(gg_trg_ZSFSX_PG)    call TriggerAddCondition(gg_trg_ZSFSX_PG,Condition(function Trig_ZSFSX_PG_Conditions))    call TriggerAddAction(gg_trg_ZSFSX_PG,function Trig_ZSFSX_PGActions)endfunctionfunction WNWWWWWNNNWNN takes unit NWWWNNNWWN returns integerlocal real NWWWNNNNWW=GetUnitState(NWWWNNNWWN,UNIT_STATE_LIFE)/GetUnitState(NWWWNNNWWN,UNIT_STATE_MAX_LIFE)local integer NWWWNNNNWN=GetUnitLevel(NWWWNNNWWN)local real NWWWNNNNNW=Pow(NWWWNNNNWN*.1+1.,1.1)local integer NWWWNNNNNN=R2I(NWWWNNNNNW*(1.+(1.-NWWWNNNNWW)*.5))local integer NWWNWWWWWW=GetHeroStr(NWWWNNNWWN,true)+GetHeroAgi(NWWWNNNWWN,true)+GetHeroInt(NWWWNNNWWN,true)local integer NWWNWWWWWN=R2I(NWWNWWWWWW*.2)if NWWWNNNNNN+1<NWWNWWWWWN thenreturn NWWWNNNNNN+1elsereturn NWWNWWWWWNendifendfunctionfunction WNWWWWWNNNNWW takes unit NWWWNNNWWN returns boolean    return IsUnitType(NWWWNNNWWN,UNIT_TYPE_HERO) and IsUnitIllusion(NWWWNNNWWN)==false and GetPlayerController(GetOwningPlayer(NWWWNNNWWN))==MAP_CONTROL_USERendfunctionfunction WNWWWWNWWWWNW takes nothing returns nothing    local unit NWWWNNNWWN=GetKillingUnit()    local unit NWWWNNNWWW=GetDyingUnit()    local player NWWWNNNWNW=GetOwningPlayer(NWWWNNNWWN)    local integer NWWWNNNWNN    local integer NWWNWWWWNW    local integer NWWNWWWNNW    local texttag NWWNWWWWNN    local boolean NWWNWWWWNZ    set NWWNWWWWNZ=WNWWWWWNNNNWW(NWWWNNNWWN)	set NWWNWWWNNW=(1*GetUnitLevel(NWWWNNNWWW))    if NWWNWWWWNZ then        call AdjustPlayerStateBJ(NWWNWWWNNW, NWWWNNNWNW, PLAYER_STATE_RESOURCE_GOLD)        call AddHeroXP(NWWWNNNWWN,NWWNWWWNNW,true)    endif    if NWWNWWWWNZ and WWNNWNWN and GetRandomInt(107,121)==115 then        set NWWWNNNWNN=WNWWWWWNNNWNN(NWWWNNNWWN)*WNWWWZWW        set NWWNWWWWNW=GetRandomInt(1,100)        if NWWNWWWWNW<=33 then            call ModifyHeroStat(bj_HEROSTAT_STR,NWWWNNNWWN,bj_MODIFYMETHOD_ADD,NWWWNNNWNN)            set NWWNWWWWNN=CreateTextTag()            call SetTextTagText(NWWNWWWWNN,"+力量 "+I2S(NWWWNNNWNN),.026)            call SetTextTagColor(NWWNWWWWNN,0,100,100,0)        elseif NWWNWWWWNW<=66 then            call ModifyHeroStat(bj_HEROSTAT_AGI,NWWWNNNWWN,bj_MODIFYMETHOD_ADD,NWWWNNNWNN)            set NWWNWWWWNN=CreateTextTag()            call SetTextTagText(NWWNWWWWNN,"+敏捷 "+I2S(NWWWNNNWNN),.026)            call SetTextTagColor(NWWNWWWWNN,100,0,100,0)        elseif NWWNWWWWNW<=99 then            call ModifyHeroStat(bj_HEROSTAT_INT,NWWWNNNWWN,bj_MODIFYMETHOD_ADD,NWWWNNNWNN)            set NWWNWWWWNN=CreateTextTag()            call SetTextTagText(NWWNWWWWNN,"+智力 "+I2S(NWWWNNNWNN),.026)            call SetTextTagColor(NWWNWWWWNN,100,100,0,0)        else            call ModifyHeroStat(bj_HEROSTAT_STR,NWWWNNNWWN,bj_MODIFYMETHOD_ADD,NWWWNNNWNN)            call ModifyHeroStat(bj_HEROSTAT_AGI,NWWWNNNWWN,bj_MODIFYMETHOD_ADD,NWWWNNNWNN)            call ModifyHeroStat(bj_HEROSTAT_INT,NWWWNNNWWN,bj_MODIFYMETHOD_ADD,NWWWNNNWNN)            set NWWNWWWWNN=CreateTextTag()            call SetTextTagText(NWWNWWWWNN,"+全属性 "+I2S(NWWWNNNWNN),.026)            call SetTextTagColor(NWWNWWWWNN,255,255,255,0)        endif        call SetTextTagPos(NWWNWWWWNN,GetUnitX(NWWWNNNWWN),GetUnitY(NWWWNNNWWN),0)        call SetTextTagVelocity(NWWNWWWWNN,0,.03)        call SetTextTagPermanent(NWWNWWWWNN,false)        call SetTextTagLifespan(NWWNWWWWNN,2.)        call SetTextTagFadepoint(NWWNWWWWNN,1.5)        set NWWNWWWWNN=null    endif    set NWWWNNNWWN=null    set NWWWNNNWWW=null    set NWWWNNNWNW=nullendfunctionfunction WWWNWWWWNWN takes nothing returns nothingif IsUnitAlly(GetTriggerUnit(),Player(0))==true and WWNNNWNW thencall UnitResetCooldown(GetTriggerUnit())call SetUnitState(GetTriggerUnit(),UNIT_STATE_MANA,GetUnitState(GetTriggerUnit(),UNIT_STATE_MAX_MANA))endifendfunctionfunction WWWNWWWWNNW takes nothing returns nothinglocal trigger NNNNWNW=CreateTrigger()local integer NNWWWNN=0loopcall TriggerRegisterPlayerUnitEvent(NNNNWNW,Player(NNWWWNN),EVENT_PLAYER_UNIT_SPELL_ENDCAST,null)call TriggerRegisterPlayerUnitEvent(NNNNWNW,Player(NNWWWNN),EVENT_PLAYER_UNIT_SPELL_FINISH,null)exitwhen NNWWWNN==15set NNWWWNN=NNWWWNN+1endloopcall TriggerAddCondition(NNNNWNW,Condition(function WWWNWWWWNWN))set NNNNWNW=nullendfunctionfunction WWWNWWWWNNN takes nothing returns nothinglocal string chatString = GetEventPlayerChatString()local integer WWWNWWWWWWNif SubStringBJ(chatString, 1, 5) == "-sdsx" and SubStringBJ(chatString, 1, 8) != "-sdsxgb" thenset WWNNWNWN=trueif StringLength(chatString) == 5 thenset WNWWWZWW = 1call DisplayTextToPlayer(GetTriggerPlayer(), 0, 0, "|cFF00FF00已设置开启当前全体杀敌概率增属性，若关闭功能可输入|r|cFF33CCFF-sdsxgb")call DisplayTextToPlayer(GetTriggerPlayer(), 0, 0, "|cFF00FF00当前模式下，全体玩家英雄单位普攻自带属性伤害和概率暴击伤害!")elseset WWWNWWWWWWN = S2I(SubStringBJ(chatString, 6, StringLength(chatString)))if WWWNWWWWWWN < 1 thenset WWWNWWWWWWN = 1elseif WWWNWWWWWWN > 999 thenset WWWNWWWWWWN = 999endifset WNWWWZWW = WWWNWWWWWWNcall DisplayTextToPlayer(GetTriggerPlayer(), 0, 0, "|cFF00FF00已设置当前全体杀敌概率增属性倍率为 " + I2S(WNWWWZWW) + "|r")endifendifif chatString == "-sdsxgb" thenset WWNNWNWN=falsecall DisplayTextToPlayer( GetTriggerPlayer(), 0, 0,"|cFF00FF00已经关闭全体杀敌概率增属性功能")endifif GetEventPlayerChatString()=="-qt" thencall FogEnable(false)call FogMaskEnableOff()call DisplayTextToPlayer( GetTriggerPlayer(), 0, 0,"已经打开所有人全图,无法关闭")endifendfunctionfunction WWWNWWWNWWW takes nothing returns nothingset WWNNWNWW=CreateTrigger()call TriggerRegisterPlayerChatEvent(WWNNWNWW,Player(0),"",true)call Trigger