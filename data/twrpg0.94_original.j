endifset zl[Yl[Ii1o]]=zl[Ii1o]set Yl[zl[Ii1o]]=Yl[Ii1o]set vL[Ii1o]=falseset Zl[Ii1o]=0return trueendfunctionfunction ol_O takes nothing returns integerlocal integer Ii1oif(eL[(0)]==0)thenif(xL==8190)then
