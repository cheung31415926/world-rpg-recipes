set t=nullendfunctionfunction qo_o takes string s,real x,real y,real z,real Oipo,integer r,integer g,integer b,real qouo,real uq6o returns texttagset rr=CreateTextTag()call SetTextTagPos(rr,x,y,z)
call SetTextTagText(rr,s,Oipo*.0023)
call SetTextTagColor(rr,r,g,b,$FF)call SetTextTagVelocity(rr,.0,.02)call SetTextTagPermanent(rr,false)call SetTextTagFadepoint(rr,qouo)call SetTextTagLifespan(rr,uq6o)
return rrendfunctionfunction qopo takes string s,real x,real y,real z,real Oipo,integer r,integer g,integer b,real qouo,real uq6o,player p returns nothingcall SetTextTagVisibility(qo_o(s,x,y,z,Oipo,r,g,b,qouo,uq6o),GetLocalPlayer()==p)endfunctionfunction qo6o takes unit u,string s,real Oipo,integer r,integer g,integer b returns texttagif IsUnitHidden(u)thenreturn nullendifreturn qo_o(s,GetUnitX(u),GetUnitY(u),GetUnitFlyHeight(u)+60,Oipo,r,g,b,1.2,2.)endfunctionfunction qoqo takes unit u,string s,real Oipo,integer r,integer g,integer b,real pq6o returns texttagif IsUnitHidden(u)thenreturn nullendifreturn qo_o(s,GetUnitX(u),GetUnitY(u),GetUnitFlyHeight(u)+60,Oipo,r,g,b,pq6o*.6,pq6o)endfunctionfunction qo9o takes unit u,string s,real Oipo,integer r,integer g,integer b returns nothingcall qo6o(u,s,Oipo,r,g,b)if rr!=null then
call SetTextTagVisibility(rr,GetLocalPlayer()==GetOwningPlayer(u))endifendfunctionfunction qOio takes unit u,integer qO1o returns nothinglocal integer lv=GetUnitAbilityLevel(u,qO1o)
if UnitRemoveAbility(u,qO1o)then
