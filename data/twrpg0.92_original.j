"
call SaveStr(Nv,(((po_l))),(popl),(poul))call lq1qi('I069',"万圣节盛会","普瑞斯的公民")set poul=poul+("普瑞斯还有一个重要的节日，就是万圣节.")+"
"set poul=poul+("这个节日也是普瑞斯的一个化妆盛会")+"
